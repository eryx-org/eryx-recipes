 int start_async(struct async *async)
 {
+#ifdef __wasi__
+	{
+		/*
+		 * No threads or fork: run it now, to completion, its output
+		 * spooled through a temp file that the caller then reads. So it
+		 * can't take input from a pipe, and a proc reading input the
+		 * caller only writes later (send-pack's receive-status demuxer)
+		 * must be started after that.
+		 */
+		char path[] = "/tmp/git-async-XXXXXX";
+		int proc_in = async->in > 0 ? async->in : -1, proc_out = -1, fd = -1;
+		if (async->in < 0) {
+			errno = ENOSYS;
+			return -1;
+		}
+		if (async->out < 0) {
+			fd = mkstemp(path);
+			if (fd < 0)
+				return -1;
+			proc_out = fd;
+		} else if (async->out > 0) {
+			proc_out = async->out;
+		}
+		async->pid = async->proc(proc_in, proc_out, async->data);
+		if (fd >= 0) {
+			async->out = open(path, O_RDONLY);
+			if (async->out < 0) {
+				unlink(path);
+				return -1;
+			}
+			/*
+			 * Removed once its reader closes it, not now: eryx's VFS
+			 * can't read a file after it's unlinked.
+			 */
+			wasi_unlink_on_close(async->out, path);
+		}
+		return 0;
+	}
+#endif
