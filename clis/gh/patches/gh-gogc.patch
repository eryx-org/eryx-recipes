@@ -0,0 +1,19 @@
+// Package gogc makes gh collect garbage less often than Go's default
+// (GOGC=100) unless GOGC is set. gh is short-lived and its package inits make
+// a lot of garbage, so on wasm the default spends about a third of startup in
+// the collector. eryx: added for the wasip3 build.
+//
+// cmd/gh imports it first, so it runs before the other packages' inits (they
+// depend on more than os and runtime/debug).
+package gogc
+
+import (
+	"os"
+	"runtime/debug"
+)
+
+func init() {
+	if os.Getenv("GOGC") == "" {
+		debug.SetGCPercent(400)
+	}
+}
