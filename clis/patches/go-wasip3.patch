@@ -0,0 +1,89 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build wasip3
+
+package work
+
+import (
+	"fmt"
+	"go/build"
+	"internal/eryx/process"
+	wasi "internal/wasi"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+)
+
+// A WASI command can't start another one, so on wasip3 the go command runs
+// its tools through eryx:process/run, where eryx registers them as go-compile,
+// go-asm and go-link. Their stubs in the tool dir only satisfy base.ToolPath.
+
+// lookTool returns file: exec.LookPath always fails on wasm.
+func lookTool(file string) (string, error) { return file, nil }
+
+var runErrors = [...]string{"command not found", "spawn failed", "limit exceeded"}
+
+// runCmd runs cmd to completion, then writes what it printed to cmd.Stdout
+// and cmd.Stderr. It reads no stdin.
+func runCmd(cmd *exec.Cmd) error {
+	name := filepath.Base(cmd.Path)
+	if filepath.Dir(cmd.Path) == filepath.Clean(build.ToolDir) {
+		name = "go-" + name
+	}
+	env := cmd.Env
+	if env == nil {
+		env = os.Environ()
+	}
+	pairs := make([][2]string, 0, len(env))
+	for _, e := range env {
+		if k, v, ok := strings.Cut(e, "="); ok {
+			pairs = append(pairs, [2]string{k, v})
+		}
+	}
+	dir := cmd.Dir
+	if dir == "" {
+		dir = "."
+	}
+	dir, err := filepath.Abs(dir)
+	if err != nil {
+		return err
+	}
+	// run caps a child's stdout and stderr at 16 MiB each; the host writes
+	// them into the arena, as cabi_realloc can't use the Go heap mid-call.
+	wasi.UseArena(2*16<<20 + 64)
+	r := process.Run(name, cmd.Args[1:], pairs, dir, nil)
+	wasi.EndArena()
+	if r.IsErr() {
+		e := int(r.Err())
+		msg := fmt.Sprintf("error %d", e)
+		if e < len(runErrors) {
+			msg = runErrors[e]
+		}
+		return fmt.Errorf("running %s: %s", name, msg)
+	}
+	out := r.OK()
+	if err := copyOut(cmd.Stdout, out.Stdout); err != nil {
+		return err
+	}
+	if err := copyOut(cmd.Stderr, out.Stderr); err != nil {
+		return err
+	}
+	if out.Status != 0 {
+		return fmt.Errorf("exit status %d", out.Status)
+	}
+	return nil
+}
+
+func copyOut(w io.Writer, b wasi.ByteBuffer) error {
+	buf := make([]byte, b.Len)
+	b.CopyInto(buf)
+	if w == nil || len(buf) == 0 {
+		return nil
+	}
+	_, err := w.Write(buf)
+	return err
+}
