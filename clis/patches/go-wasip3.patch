diff --git a/src/internal/eryx/process/run.go b/src/internal/eryx/process/run.go
new file mode 100644
index 00000000..e63887ed
--- /dev/null
+++ b/src/internal/eryx/process/run.go
@@ -0,0 +1,89 @@
+// Code generated by witgen from eryx:process@0.1.0/run. DO NOT EDIT.
+//
+// Generated by internal/wasi/cmd/witgen from eryx-commands' wit/process.wit,
+// then one fix by hand: Run's env is [][2]string (a [2]string has the
+// canonical ABI layout of tuple<string, string> on wasm32), which witgen
+// generated as []int32.
+
+//go:build wasip3
+
+package process
+
+import (
+	wasi "internal/wasi"
+	"unsafe"
+)
+
+// Output represents the output record.
+type Output struct {
+	Status int32
+	Stdout wasi.ByteBuffer
+	Stderr wasi.ByteBuffer
+}
+
+// RunError represents the run-error enum.
+type RunError uint8
+
+const (
+	RunErrorCommandNotFound RunError = iota
+	RunErrorSpawnFailed
+	RunErrorLimitExceeded
+)
+
+// ResultOutputRunError wraps result<output, runerror> (24 bytes).
+// Uses inline storage — no heap allocation on return.
+type ResultOutputRunError struct {
+	_ [0]int64
+	b [24]byte
+}
+
+const ResultOutputRunErrorSize = 24
+
+func (r ResultOutputRunError) IsErr() bool { return r.b[0] != 0 }
+
+func (r ResultOutputRunError) Err() RunError {
+	if r.b[0] == 0 {
+		panic("ResultOutputRunError: result is ok")
+	}
+	return RunError(r.b[4])
+}
+
+func (r ResultOutputRunError) OK() Output {
+	if r.b[0] != 0 {
+		panic("ResultOutputRunError: result is err")
+	}
+	return Output{
+		Status: int32(*(*int32)(unsafe.Pointer(&r.b[4]))),
+		Stdout: wasi.ByteBuffer{Ptr: *(*int32)(unsafe.Pointer(&r.b[8])), Len: *(*int32)(unsafe.Pointer(&r.b[12]))},
+		Stderr: wasi.ByteBuffer{Ptr: *(*int32)(unsafe.Pointer(&r.b[16])), Len: *(*int32)(unsafe.Pointer(&r.b[20]))},
+	}
+}
+
+//go:wasmimport eryx:process/run@0.1.0 run
+//go:noescape
+func run(cmd0 int32, cmd1 int32, args0 int32, args1 int32, env0 int32, env1 int32, cwd0 int32, cwd1 int32, stdin0 int32, stdin1 int32, retptr unsafe.Pointer)
+
+func Run(cmd string, args []string, env [][2]string, cwd string, stdin []byte) ResultOutputRunError {
+	cmdPtr, cmdLen := wasi.StringToPtr(cmd)
+	var argsPtr int32
+	if len(args) > 0 {
+		argsPtr = int32(uintptr(unsafe.Pointer(unsafe.SliceData(args))))
+	}
+	var envPtr int32
+	if len(env) > 0 {
+		envPtr = int32(uintptr(unsafe.Pointer(unsafe.SliceData(env))))
+	}
+	cwdPtr, cwdLen := wasi.StringToPtr(cwd)
+	var stdinPtr int32
+	if len(stdin) > 0 {
+		stdinPtr = int32(uintptr(unsafe.Pointer(unsafe.SliceData(stdin))))
+	}
+	var result ResultOutputRunError
+	run(cmdPtr, cmdLen, argsPtr, int32(len(args)), envPtr, int32(len(env)), cwdPtr, cwdLen, stdinPtr, int32(len(stdin)), unsafe.Pointer(&result))
+	wasi.KeepAlive(cmd)
+	wasi.KeepAlive(args)
+	wasi.KeepAlive(env)
+	wasi.KeepAlive(cwd)
+	wasi.KeepAlive(stdin)
+	return result
+}
