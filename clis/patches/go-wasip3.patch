+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build wasip3
+
+package filelock
+
+// WASI has no file locks. Locking always succeeds.
+// ponytail: an eryx sandbox runs one go command at a time, so nothing
+// contends for GOCACHE or go.mod; real locks if that ever changes.
+
+type lockType int8
+
+const (
+	readLock = iota + 1
+	writeLock
+)
+
+func lock(f File, lt lockType) error { return nil }
+
+func unlock(f File) error { return nil }
