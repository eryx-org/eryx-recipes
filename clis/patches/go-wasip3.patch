@@ -338,3 +345,61 @@ func IsReturned(status int32) bool {
 func Subtask(status int32) int32 {
 	return status >> HandleShift
 }
+
+// --- Arena for long host calls ---
+//
+// cabi_realloc normally allocates on the Go heap. That's unsafe when the host
+// calls it in the middle of a long import (eryx:process/run, which runs a
+// whole child command): if a GC cycle is under way, the allocation may assist
+// or switch goroutines, which the wasm port can't do with the host's frame
+// on the stack. Callers of such imports bracket them with UseArena and
+// EndArena, and cabi_realloc bump-allocates from a buffer allocated up front.
+
+var (
+	arena    []byte
+	arenaOff int
+	arenaOn  bool
+)
+
+// UseArena makes cabi_realloc allocate from an arena of at least size bytes
+// until EndArena. The arena is allocated once and reused; what was allocated
+// from it last time must have been copied out.
+func UseArena(size int) {
+	if len(arena) < size {
+		arena = make([]byte, size)
+	}
+	arenaOff = 0
+	arenaOn = true
+}
+
+// EndArena makes cabi_realloc allocate on the Go heap again. Buffers from the
+// arena stay valid until the next UseArena.
+func EndArena() { arenaOn = false }
+
+func inArena(ptr int32) bool {
+	if len(arena) == 0 {
+		return false
+	}
+	base := uintptr(unsafe.Pointer(unsafe.SliceData(arena)))
+	return uintptr(ptr) >= base && uintptr(ptr) < base+uintptr(len(arena))
+}
+
+// arenaRealloc bump-allocates [header | data] from the arena, 8-byte
+// aligned. It returns 0 if the arena is full: size it for the most the host
+// can return.
+func arenaRealloc(oldPtr, oldSize, newSize int32) int32 {
+	total := (int(reallocHeaderSize) + int(newSize) + 7) &^ 7
+	if arenaOff+total > len(arena) {
+		return 0
+	}
+	buf := arena[arenaOff : arenaOff+total]
+	arenaOff += total
+	*(*int32)(unsafe.Pointer(&buf[0])) = int32(total)
+	dataPtr := int32(uintptr(unsafe.Pointer(unsafe.SliceData(buf))) + reallocHeaderSize)
+	if oldPtr != 0 && oldSize > 0 {
+		old := unsafe.Slice((*byte)(unsafe.Pointer(uintptr(oldPtr))), oldSize)
+		copy(buf[reallocHeaderSize:], old)
+		FreeRealloc(oldPtr)
+	}
+	return dataPtr
+}
