+
+// SetReferenceLong sets the reference help topic's Long text, for doc generation. Call it right
+// after NewCmdRoot.
+func SetReferenceLong(cmd *cobra.Command) {
+	for _, c := range cmd.Commands() {
+		if c.Name() == "reference" {
+			c.Long = stringifyReference(cmd)
+		}
+	}
