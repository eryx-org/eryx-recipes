+/// Short options that take no argument, which may be bundled: `-ru` is `-r -u`.
+const BUNDLEABLE_FLAGS: &str = "sqNrateyupc";
+
+/// The arguments with bundled short options split up (`-Naur` becomes `-N -a
+/// -u -r`), as getopt allows. Only an argument made up entirely of
+/// [`BUNDLEABLE_FLAGS`] is split, so `-U3` and `-Fpattern` are left alone, and
+/// nothing after `--` is touched.
+fn split_bundled_flags(args: Vec<OsString>) -> Vec<OsString> {
+    let mut out = Vec::with_capacity(args.len());
+    let mut args = args.into_iter();
+    // The program name is never an option.
+    out.extend(args.next());
+    for arg in args.by_ref() {
+        if arg == "--" {
+            out.push(arg);
+            break;
+        }
+        match arg.to_str().and_then(|a| a.strip_prefix('-')) {
+            Some(flags)
+                if flags.len() > 1 && flags.chars().all(|c| BUNDLEABLE_FLAGS.contains(c)) =>
+            {
+                out.extend(flags.chars().map(|c| OsString::from(format!("-{c}"))));
+            }
+            _ => out.push(arg),
+        }
+    }
+    out.extend(args);
+    out
+}
