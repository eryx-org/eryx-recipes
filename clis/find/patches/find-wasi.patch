diff --git a/src/find/matchers/eryx_run.rs b/src/find/matchers/eryx_run.rs
new file mode 100644
index 0000000..c440d72
--- /dev/null
+++ b/src/find/matchers/eryx_run.rs
@@ -0,0 +1,88 @@
+// eryx: -exec and -execdir on WASI. A WASI command can't start another one,
+// so find runs its commands through the host's eryx:process/run, as git does.
+// The host runs them only if it lets find spawn; their output is captured,
+// so it shows once each has exited, and they get no stdin.
+
+use std::ffi::OsStr;
+use std::io::{self, Write};
+use std::process::Command;
+
+use eryx::process::run::{run, RunError};
+
+wit_bindgen::generate!({
+    inline: "package eryx:find; world exec { import eryx:process/run@0.1.0; }",
+    path: "wit/process.wit",
+    generate_all,
+});
+
+/// How a command ended: what `std::process::ExitStatus` tells upstream.
+pub struct Status(i32);
+
+impl Status {
+    pub fn success(&self) -> bool {
+        self.0 == 0
+    }
+}
+
+fn utf8(s: &OsStr) -> io::Result<String> {
+    s.to_str().map(str::to_owned).ok_or_else(|| {
+        io::Error::new(
+            io::ErrorKind::InvalidInput,
+            format!("{} isn't valid UTF-8", s.to_string_lossy()),
+        )
+    })
+}
+
+/// Run `command` (its program, arguments and working directory) through the
+/// host, with find's environment, and write out what it printed.
+pub fn status(command: &Command) -> io::Result<Status> {
+    let program = utf8(command.get_program())?;
+    let args = command
+        .get_args()
+        .map(utf8)
+        .collect::<io::Result<Vec<_>>>()?;
+    let mut cwd = std::env::current_dir()?;
+    if let Some(dir) = command.get_current_dir() {
+        // components() drops the `.` -execdir's directories start with.
+        cwd = cwd.join(dir).components().collect();
+    }
+    let cwd = utf8(cwd.as_os_str())?;
+    // The host takes the child's directory from PWD when it's set, and
+    // find's own is: replace it with the command's.
+    let mut env: Vec<(String, String)> = std::env::vars().filter(|(k, _)| k != "PWD").collect();
+    env.push(("PWD".to_owned(), cwd.clone()));
+
+    let mut output = run(&program, &args, &env, &cwd, &[]);
+    // The shell's builtins (echo, true, its grep) aren't commands the host
+    // can run, so run one through `sh`, which has them.
+    // ponytail: an extra spawn per miss; drop it once eryx:process/run runs
+    // the shell's builtins itself.
+    if let Err(RunError::CommandNotFound) = output {
+        let mut sh_args = vec![
+            "-c".to_owned(),
+            "\"$@\"".to_owned(),
+            "sh".to_owned(),
+            program.clone(),
+        ];
+        sh_args.extend(args.iter().cloned());
+        if let Ok(ran) = run("sh", &sh_args, &env, &cwd, &[]) {
+            // sh's 127: not a builtin either.
+            if ran.status != 127 {
+                output = Ok(ran);
+            }
+        }
+    }
+    let output = output.map_err(|e| match e {
+        RunError::CommandNotFound => io::Error::new(io::ErrorKind::NotFound, "command not found"),
+        RunError::SpawnFailed => io::Error::other(
+            "the host couldn't run it, or doesn't let find run commands (spawn-failed)",
+        ),
+        RunError::LimitExceeded => {
+            io::Error::other("the host's limits on child processes were reached (limit-exceeded)")
+        }
+    })?;
+    io::stdout().write_all(&output.stdout)?;
+    io::stdout().flush()?;
+    io::stderr().write_all(&output.stderr)?;
+    Ok(Status(output.status))
+}
