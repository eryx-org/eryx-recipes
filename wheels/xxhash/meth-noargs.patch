METH_NOARGS methods are called as f(self, NULL), but _xxhash.c defines
them as f(self). That's fine on native ABIs, but WebAssembly checks the
type of every indirect call, so calling digest() and the rest traps with
"indirect call type mismatch". Give them the two-parameter signature.

--- a/src/_xxhash.c
+++ b/src/_xxhash.c
@@ -890 +890 @@
-static PyObject *PYXXH32_digest(PYXXH32Object *self)
+static PyObject *PYXXH32_digest(PYXXH32Object *self, PyObject *Py_UNUSED(ignored))
@@ -909 +909 @@
-static PyObject *PYXXH32_hexdigest(PYXXH32Object *self)
+static PyObject *PYXXH32_hexdigest(PYXXH32Object *self, PyObject *Py_UNUSED(ignored))
@@ -940 +940 @@
-static PyObject *PYXXH32_intdigest(PYXXH32Object *self)
+static PyObject *PYXXH32_intdigest(PYXXH32Object *self, PyObject *Py_UNUSED(ignored))
@@ -953 +953 @@
-static PyObject *PYXXH32_copy(PYXXH32Object *self)
+static PyObject *PYXXH32_copy(PYXXH32Object *self, PyObject *Py_UNUSED(ignored))
@@ -982 +982 @@
-static PyObject *PYXXH32_reset(PYXXH32Object *self)
+static PyObject *PYXXH32_reset(PYXXH32Object *self, PyObject *Py_UNUSED(ignored))
@@ -1241 +1241 @@
